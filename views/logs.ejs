<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IRC Chat Logs</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/d3-cloud@1.2.5/build/d3.layout.cloud.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://d3js.org/d3.v6.min.js"></script>
    <style>
        .highlight { background-color: yellow; font-weight: bold; }
        .sentiment-positive { color: green; font-weight: bold; }
        .sentiment-negative { color: red; font-weight: bold; }
        .sentiment-neutral { color: gray; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h2 class="mb-3">📜 IRC Chat Logs</h2>

        <!-- Chat Statistics -->
        <h4>📊 Chat Statistics</h4>
        <p><strong>Total Messages:</strong> <%= totalMessages %></p>
        <h5>Top 5 Most Active Users:</h5>
        <ul>
            <% topUsers.forEach(user => { %>
                <li><%= user.user %> - <%= user.count %> messages</li>
            <% }) %>
        </ul>

        <!-- Sentiment Analysis Summary -->
        <h4>🧠 Sentiment Analysis</h4>
        <ul>
            <% sentimentStats.forEach(stat => { %>
                <li><span class="<%= stat.sentiment.toLowerCase() === 'positive' ? 'sentiment-positive' : stat.sentiment.toLowerCase() === 'negative' ? 'sentiment-negative' : 'sentiment-neutral' %>">
                    <%= stat.sentiment %>: <%= stat.count %> messages
                </span></li>
            <% }) %>
        </ul>

        <!-- Sentiment Pie Chart -->
        <h4>📊 Sentiment Distribution</h4>
        <canvas id="sentimentChart" width="400" height="200"></canvas>

        <!-- Word Cloud -->
        <h4>☁️ Word Cloud</h4>
        <svg id="wordCloud" width="600" height="400"></svg>

        <!-- Search Logs -->
        <form method="GET" action="/logs" class="mb-3 d-flex align-items-center gap-2">
            <input type="text" name="search" id="searchBar" class="form-control" placeholder="Search messages..." value="<%= searchQuery || '' %>">
            <button type="submit" class="btn btn-info">🔍 Search</button>
            <button type="button" id="clearSearch" class="btn btn-danger">❌ Clear</button>
        </form>

        <!-- Chat Log Filters -->
        <form method="GET" action="/logs" class="mb-3 d-flex align-items-center gap-2">
            <label for="start">Start Date:</label>
            <input type="date" name="start" class="form-control" value="<%= startDate %>">

            <label for="end">End Date:</label>
            <input type="date" name="end" class="form-control" value="<%= endDate %>">

            <label for="sentiment">Sentiment:</label>
            <select name="sentiment" class="form-control">
                <option value="">All</option>
                <option value="Positive">Positive</option>
                <option value="Neutral">Neutral</option>
                <option value="Negative">Negative</option>
            </select>

            <button type="submit" class="btn btn-primary">Filter</button>
        </form>

        <!-- Export Buttons -->
        <div class="mb-3">
            <a href="/export/csv" class="btn btn-success">📥 Export as CSV</a>
            <a href="/export/json" class="btn btn-warning">📥 Export as JSON</a>
        </div>

        <!-- Chat Logs Table -->
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Message</th>
                    <th>Sentiment</th>
                </tr>
            </thead>
            <tbody id="logTable">
                <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.timestamp %></td>
                        <td><a href="/user/<%= log.user %>" class="text-decoration-none"><%= log.user %></a></td>
                        <td class="message-text"><%= log.message %></td>
                        <td><span class="<%= log.sentiment.toLowerCase() === 'positive' ? 'sentiment-positive' : log.sentiment.toLowerCase() === 'negative' ? 'sentiment-negative' : 'sentiment-neutral' %>">
                            <%= log.sentiment %>
                        </span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Active Users -->
        <div class="mt-4">
            <h4>👥 Active Users</h4>
            <ul id="activeUsers" class="list-group">
                <% activeUsers.forEach(user => { %>
                    <li class="list-group-item"><%= user %></li>
                <% }) %>
            </ul>
        </div>
    </div>

    <!-- Socket.IO for Live Updates -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();

        // Sentiment Pie Chart
        const sentimentData = <%- JSON.stringify(sentimentStats) %>;

        if (sentimentData.length > 0) {
            const ctx = document.getElementById('sentimentChart').getContext('2d');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: sentimentData.map(s => s.sentiment),
                    datasets: [{
                        data: sentimentData.map(s => s.count),
                        backgroundColor: ['green', 'gray', 'red']
                    }]
                }
            });
        } else {
            document.getElementById('sentimentChart').style.display = "none";
        }

        // Word Cloud
        const wordCloudData = <%- wordCloudData %>;

        if (wordCloudData.length > 0) {
            const svg = d3.select("#wordCloud"),
                width = +svg.attr("width"),
                height = +svg.attr("height");

            const layout = d3.layout.cloud()
                .size([width, height])
                .words(wordCloudData)
                .padding(5)
                .rotate(() => 0)
                .fontSize(d => d.size)
                .on("end", draw);

            layout.start();

            function draw(words) {
                svg.append("g")
                    .attr("transform", `translate(${width / 2},${height / 2})`)
                    .selectAll("text")
                    .data(words)
                    .enter().append("text")
                    .style("font-size", d => d.size + "px")
                    .attr("text-anchor", "middle")
                    .attr("fill", "blue")
                    .attr("transform", d => `translate(${d.x}, ${d.y})`)
                    .text(d => d.text);
            }
        } else {
            document.getElementById('wordCloud').style.display = "none";
        }
    </script>

    
</body>
</html>
